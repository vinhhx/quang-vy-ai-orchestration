{
  "version": 1,
  "cases": [
    {
      "id": "P1-05",
      "layout": {
        "roots": {
          "R": {
            "web-ban-hang": {
              "git": true,
              "remote": "git@example.com:org/web.git"
            },
            "notes": {
              "git": false
            }
          }
        }
      },
      "steps": [
        {
          "op": "scan",
          "roots": ["R"]
        },
        {
          "op": "edit",
          "project": "web-ban-hang",
          "set": {
            "name_vi": "Web bán hàng",
            "aliases": ["shop"],
            "profile": "work"
          }
        },
        {
          "op": "mkrepo",
          "root": "R",
          "name": "tool-moi",
          "remote": null
        },
        {
          "op": "scan"
        }
      ],
      "expect": {
        "exit_codes": [0, 0, 0, 0],
        "projects": {
          "web-ban-hang": {
            "id": "web-ban-hang",
            "name_vi": "Web bán hàng",
            "aliases": ["shop"],
            "profile": "work",
            "type": "code",
            "repo": "git@example.com:org/web.git",
            "missing": false
          },
          "tool-moi": {
            "id": "tool-moi",
            "name_vi": "tool-moi",
            "aliases": [],
            "profile": "",
            "type": "code",
            "repo": null,
            "missing": false
          }
        },
        "absent": ["notes"],
        "warnings": []
      }
    },
    {
      "id": "ROUTE-06-alias",
      "layout": {
        "roots": {
          "R": {
            "proj-a": {
              "git": true
            },
            "proj-b": {
              "git": true
            }
          }
        }
      },
      "steps": [
        {
          "op": "scan",
          "roots": ["R"]
        },
        {
          "op": "edit",
          "project": "proj-a",
          "set": {
            "aliases": ["shop"]
          }
        },
        {
          "op": "edit",
          "project": "proj-b",
          "set": {
            "aliases": ["shop"]
          }
        },
        {
          "op": "scan"
        }
      ],
      "expect": {
        "exit_codes": [0, 0, 0, 0],
        "projects": {
          "proj-a": {
            "id": "proj-a",
            "aliases": ["shop"]
          },
          "proj-b": {
            "id": "proj-b",
            "aliases": ["shop"]
          }
        },
        "absent": [],
        "warnings": [
          {
            "key": "shop",
            "ids": ["proj-a", "proj-b"]
          }
        ]
      }
    },
    {
      "id": "ROUTE-06-alias-vs-id",
      "layout": {
        "roots": {
          "R": {
            "shop": {
              "git": true
            },
            "other": {
              "git": true
            }
          }
        }
