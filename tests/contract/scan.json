          }
        },
        "absent": [],
        "warnings": [
          {
            "key": "shop",
            "ids": ["shop", "other"]
          }
        ]
      }
    },
    {
      "id": "D-06-depth",
      "layout": {
        "roots": {
          "R": {
            "top-repo": {
              "git": true
            },
            "group": {
              "git": false,
              "children": {
                "inner": {
                  "git": true
                }
              }
            }
          }
        }
      },
      "steps": [
        {
          "op": "scan",
          "roots": ["R"]
        }
      ],
      "expect": {
        "exit_codes": [0],
        "projects": {
          "top-repo": {
            "id": "top-repo",
            "type": "code",
            "missing": false
          }
        },
        "absent": ["group", "inner"],
        "warnings": []
      }
    },
    {
