{
  "autopilot": {
    "max_rounds": 3,
    "budget_minutes": 60,
    "budget_usd": 20,
    "max_budget_extension_minutes": 240,
    "max_budget_extension_usd": 20
  },
  "claude_bin": "claude",
  "common_args": [
    "--strict-mcp-config"
  ],
  "dashboard_port": 7437,
  "engines": {
    "deepseek": {
      "command": "claude",
      "base_url": "https://api.deepseek.com/anthropic",
      "key_env": "DEEPSEEK_API_KEY",
      "models": {
        "lead": "opus",
        "dev": "sonnet",
        "qa": "sonnet",
        "plan-review": "opus",
        "code-review": "opus"
      }
    },
    "agy": {
      "command": "agy",
      "print_timeout_margin_secs": 30,
      "model": null
    }
  },
  "inspect_max_diff_bytes": 100000,
  "inspect_model": "sonnet",
  "kill_grace_secs": 3,
  "max_turns": {
    "lead": null,
    "dev": null,
    "qa": null,
    "plan-review": null,
    "code-review": null
  },
  "merge": {
    "default_base_branch": "dev",
    "git_timeout_secs": 120,
    "delete_task_branch": true
  },
  "models": {
    "lead": "opus",
    "dev": "sonnet",
    "qa": "sonnet"
  },
  "orchestrator": {
    "enabled": false,
    "max_parallel": 3,
    "auto_resume_quota": false,
    "resume_after_minutes": 60,
    "triage_engine": "claude",
    "restore_team_after_quota": false
  },
  "pricing": {
    "opus": {
      "input": 4.0,
      "output": 20.0,
      "cache_read": 0.2,
      "cache_write": 8.0
    },
    "sonnet": {
      "input": 2.0,
      "output": 10.0,
      "cache_read": 0.1,
      "cache_write": 4.0
    },
    "haiku": {
      "input": 0.1,
      "output": 0.5,
      "cache_read": 0.005,
      "cache_write": 0.2
    }
  },
  "profiles": {
    "work": {
      "claude_config_dir": null,
      "unset_env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL"
      ]
    },
    "personal": {
      "claude_config_dir": "~/.claude-orca",
      "unset_env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_AUTH_TOKEN",
        "ANTHROPIC_BASE_URL"
      ]
    }
  },
  "runs_dir": null,
  "timeout_seconds": {
    "lead": 1800,
    "dev": 1800,
    "qa": 1200,
    "inspect": 300,
    "plan-review": 1200,
    "code-review": 1500
  }
}
